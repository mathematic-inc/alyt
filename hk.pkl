amends ".hk/org.pkl"

exclude = super.exclude + List("patches/**")

steps {
  // oxfmt loads the Svelte compiler from the node_modules folder that holds it.
  ["oxfmt"] {
    check = "pnpm exec oxfmt --check --no-error-on-unmatched-pattern {{ files }}"
    check_diff = "pnpm exec oxfmt --check --no-error-on-unmatched-pattern {{ files }}"
    fix = "pnpm exec oxfmt --write --no-error-on-unmatched-pattern {{ files }}"
  }
}
