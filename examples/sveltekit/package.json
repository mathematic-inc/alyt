{
  "name": "@alyt/example-sveltekit",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "generate": "alyt-codegen --schema analytics.schema.yaml --out src/lib/generated",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@alyt/core": "workspace:*",
    "@alyt/svelte": "workspace:*"
  },
  "devDependencies": {
    "@alyt/codegen": "workspace:*",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.6"
  }
}
